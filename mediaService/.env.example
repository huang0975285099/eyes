# 复制为 .env 后填写。数据库由 docker-compose.yml 内的 MySQL 8.1.0 提供。
# 数据库：mysql:3306，账号 root，密码 all_seeing_eyes，库名 eyes。
# MediaService管理/API端口为22222，AIService状态端口为11111。

# 必须与 app/config.json 的 apiKey 一致。
CLIENT_API_KEY=Yx7pK4vN9mQ2tR8wF6cH3sD5jL1aZ0eB
PUBLIC_RTMP_HOST=112.18.238.6:1935

MEDIA_SRS_HTTP_HOST=112.18.238.6:8090

# 客户端更新 ZIP 上传管理密钥。
UPDATE_ADMIN_KEY=EyesUpdate_2026_x8K9p2Lm

# AIService Worker。第一版只执行录像抽帧；后续算法沿用同一平台扩展。
AI_WORKER_ID=ai-worker-01
AI_CONCURRENCY=4
AI_POLL_INTERVAL=3
AI_HEARTBEAT_INTERVAL=10
AI_JOB_LEASE_SECONDS=300
AI_REQUEST_TIMEOUT=15
AI_FFMPEG_TIMEOUT=120

# 后续Qwen视觉复核模块使用。API Key只写入各服务器自己的.env，不要提交到Git。
# Base URL和模型必须与API Key所在的阿里云百炼地域一致。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VL_MODEL=qwen3.6-flash
