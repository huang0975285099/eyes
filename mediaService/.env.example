# 复制为 .env 后填写。数据库由 docker-compose.yml 内的 MySQL 8.1.0 提供。
# 数据库：mysql:3306，账号 root，密码 all_seeing_eyes，库名 eyes。
# MediaService管理/API端口为22222，AIService状态端口为11111。

PUBLIC_RTMP_HOST=112.18.238.6:1935

MEDIA_SRS_HTTP_HOST=112.18.238.6:18889

# 尚未单独保存规则的视频源默认录像保留小时数。
RECORDING_RETAIN_HOURS=48

# 客户端更新 ZIP 上传管理密钥。
UPDATE_ADMIN_KEY=EyesUpdate_2026_x8K9p2Lm

# AIService Worker。第一版直接从SRS实时流抽帧；后续算法沿用同一平台扩展。
AI_WORKER_ID=ai-worker-01
AI_CONCURRENCY=4
AI_POLL_INTERVAL=3
AI_HEARTBEAT_INTERVAL=10
AI_JOB_LEASE_SECONDS=300
AI_REQUEST_TIMEOUT=15
AI_FFMPEG_TIMEOUT=30
AI_REALTIME_SYNC_INTERVAL=5
AI_REALTIME_MAX_FPS=8
AI_REALTIME_RING_SECONDS=30
AI_REALTIME_TEMPORAL_SECONDS=8
AI_REALTIME_RECONNECT_INTERVAL=3
AI_REALTIME_CONCURRENCY=4
AI_REALTIME_FRAME_WIDTH=960
AI_ALGORITHM_FAILURE_THRESHOLD=5
AI_ALGORITHM_RETRY_SECONDS=30
AI_EVENT_PRE_SECONDS=5
AI_EVENT_POST_SECONDS=3
AI_EVENT_CLIP_FPS=4
AI_EVENT_CONCURRENCY=2
AI_EVENT_RETAIN_HOURS=720

# 后续Qwen视觉复核模块使用。API Key只写入各服务器自己的.env，不要提交到Git。
# Base URL和模型必须与API Key所在的阿里云百炼地域一致。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VL_MODEL=qwen3.6-flash
