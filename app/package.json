{
    "name": "all-seeing-eyes",
    "productName": "千里眼",
    "version": "1.0.0",
    "description": "客户端设备信息采集与屏幕推流",
    "author": "eyes",
    "main": "./out/main/index.js",
    "scripts": {
        "format": "prettier --write .",
        "lint": "eslint --cache .",
        "start": "chcp 65001 && electron-vite preview",
        "dev": "chcp 65001 && electron-vite dev",
        "build": "electron-vite build",
        "postinstall": "electron-builder install-app-deps",
        "build:unpack": "pnpm build && electron-builder --dir",
        "build:win": "pnpm build && electron-builder --win"
    },
    "dependencies": {
        "vue": "^3.5.17"
    },
    "devDependencies": {
        "@electron-toolkit/eslint-config": "^2.0.0",
        "@electron-toolkit/eslint-config-prettier": "^3.0.0",
        "@vitejs/plugin-vue": "^5.2.3",
        "electron": "^37.2.3",
        "electron-builder": "^25.1.8",
        "electron-vite": "^3.1.0",
        "eslint": "^9.24.0",
        "eslint-plugin-vue": "^10.0.0",
        "prettier": "^3.6.2",
        "vite": "^6.2.6",
        "vue-eslint-parser": "^10.1.3"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "electron",
            "esbuild"
        ]
    }
}
