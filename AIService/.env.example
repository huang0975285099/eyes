AI_MEDIA_API=http://media-service:22222
# 浏览器能够访问的SRS HTTP-FLV地址；不要填写Docker内部主机名srs。
AI_SRS_PUBLIC_BASE=http://112.18.238.6:18889
AI_EVIDENCE_ROOT=/var/recordings
AI_WORKER_ID=ai-worker-01
AI_CONCURRENCY=4
AI_POLL_INTERVAL=3
AI_HEARTBEAT_INTERVAL=10
AI_JOB_LEASE_SECONDS=300
AI_REQUEST_TIMEOUT=15
AI_FFMPEG_PATH=ffmpeg
AI_FFMPEG_TIMEOUT=30
AI_HEALTH_PORT=11111

# 实时AI公共底座。每路视频只启动一个FFmpeg解码进程，再按算法sample_fps分发。
AI_REALTIME_SYNC_INTERVAL=5
AI_REALTIME_MAX_FPS=8
AI_REALTIME_RING_SECONDS=30
AI_REALTIME_RECONNECT_INTERVAL=3
AI_REALTIME_CONCURRENCY=4
AI_REALTIME_FRAME_WIDTH=960
AI_EVENT_PRE_SECONDS=5
AI_EVENT_POST_SECONDS=3
AI_EVENT_CLIP_FPS=4

# 后续Qwen视觉复核模块使用；当前frame_sampler不会调用模型API。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VL_MODEL=qwen3.6-flash
